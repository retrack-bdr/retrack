<Layouts.flash_group flash={@flash} />
<div class="w-full flex flex-col items-center">
  <div>
    <h1 class="text-4xl">
      Your business documents should work like <span class="text-primary">[ software ]</span>.
    </h1>
  </div>

  <div class="flex flex-col lg:flex-row justify-between py-5">
    <div class="w-full items-center flex flex-col">
      <h2 class="text-2xl">What I experienced as a freelancer.</h2>

      <p class="m-2 p-2 text-lg rounded-full border border-primary">Proposal.docx</p>
      <div class="flex flex-col items-center">
        <p>|</p>
        <p><span class="text-primary"> [ Document Count: 1 ] </span></p>
        <.icon name="hero-arrow-down" class="size-5 shrink-0" />
      </div>

      <p class="m-2 p-2 text-lg rounded-full border border-primary">Proposal_v2.docx</p>
      <div class="flex flex-col items-center">
        <p>|</p>
        <p><span class="text-primary"> [ Document Count: 2 ] </span></p>
        <.icon name="hero-arrow-down" class="size-5 shrink-0" />
      </div>
      <p class="m-2 p-2 text-lg rounded-full border border-primary">Proposal_FINAL.docx</p>
      <div class="flex flex-col items-center">
        <p>|</p>
        <p><span class="text-primary"> [ Document Count: 3 ] </span></p>
        <.icon name="hero-arrow-down" class="size-5 shrink-0" />
      </div>
      <p class="m-2 p-2 text-lg rounded-full border border-primary">Proposal.pdf</p>
      <div class="flex flex-col items-center">
        <p>|</p>
        <p><span class="text-primary"> [ Document Count: 4 ] </span></p>
        <.icon name="hero-arrow-down" class="size-5 shrink-0" />
      </div>
      <p class="m-2 p-2 text-lg rounded-full border border-primary">Contract.pdf</p>
      <div class="flex flex-col items-center">
        <p>|</p>
        <p><span class="text-primary"> [ Document Count: 5 ] </span></p>
        <.icon name="hero-arrow-down" class="size-5 shrink-0" />
      </div>
      <p class="m-2 p-2 text-lg rounded-full border border-primary">Invoice.pdf</p>
      <div class="flex flex-col items-center">
        <p>|</p>
        <p><span class="text-primary"> Email [ Document Count: 6 ] </span></p>
        <.icon name="hero-arrow-down" class="size-5 shrink-0" />
      </div>
      <p class="m-2 p-2 text-lg rounded-full border border-primary">Finalize Project</p>
    </div>

    <div>
      <h2 class="text-2xl">With retrack</h2>

      <RetrackWeb.Components.OneDocument.runtime />

      <p>
        Every stage of your business process should be on <span class="text-primary"> [ one document ] </span>. Review it, approve it, export it as a proposal, transform it into a contract, generate invoices, and keep a complete audit trail from the first draft to the final payment.
      </p>
    </div>
  </div>
</div>
